# Development Environment
ENVIRONMENT=development
SECRET_KEY=dev-secret-key-change-in-development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scholarmatch_dev
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Sentry (disabled in dev)
SENTRY_DSN=
OTEL_ENABLED=false

# Rate Limits (relaxed for development)
RATE_LIMIT_AUTH=100
RATE_LIMIT_AI=100
RATE_LIMIT_UPLOAD=100

# Email (console backend in dev)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=noreply@localhost

# AI/Embedding (mock in dev)
EMBEDDING_MODEL_NAME=text-embedding-3-small
QWEN_API_KEY=
QWEN_TIMEOUT_SECONDS=30
QWEN_MAX_RETRIES=3

# Retention
ACCOUNT_DELETION_GRACE_DAYS=7

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
