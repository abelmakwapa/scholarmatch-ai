# Production Environment
ENVIRONMENT=production
SECRET_KEY=${PRODUCTION_SECRET_KEY}
DATABASE_URL=${PRODUCTION_DATABASE_URL}
REDIS_URL=${PRODUCTION_REDIS_URL}

# CORS
CORS_ORIGINS=https://scholarmatch.org

# Sentry
SENTRY_DSN=${PRODUCTION_SENTRY_DSN}
OTEL_ENABLED=true
SENTRY_TRACES_SAMPLE_RATE=0.1

# Rate Limits (strict in production)
RATE_LIMIT_AUTH=10
RATE_LIMIT_AI=30
RATE_LIMIT_UPLOAD=20

# Email
EMAIL_PROVIDER_API_KEY=${PRODUCTION_EMAIL_API_KEY}
EMAIL_FROM_ADDRESS=noreply@scholarmatch.org

# AI/Embedding
EMBEDDING_MODEL_NAME=text-embedding-3-small
QWEN_API_KEY=${PRODUCTION_QWEN_API_KEY}
QWEN_TIMEOUT_SECONDS=30
QWEN_MAX_RETRIES=3

# Retention
ACCOUNT_DELETION_GRACE_DAYS=30

# Celery
CELERY_BROKER_URL=${PRODUCTION_CELERY_BROKER_URL}
CELERY_RESULT_BACKEND=${PRODUCTION_CELERY_RESULT_BACKEND}

# Security
MAX_REQUEST_SIZE_MB=10
