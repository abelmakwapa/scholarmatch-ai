# Staging Environment
ENVIRONMENT=staging
SECRET_KEY=${STAGING_SECRET_KEY}
DATABASE_URL=${STAGING_DATABASE_URL}
REDIS_URL=${STAGING_REDIS_URL}

# CORS
CORS_ORIGINS=https://staging.scholarmatch.org

# Sentry
SENTRY_DSN=${STAGING_SENTRY_DSN}
OTEL_ENABLED=true
SENTRY_TRACES_SAMPLE_RATE=0.5

# Rate Limits
RATE_LIMIT_AUTH=20
RATE_LIMIT_AI=50
RATE_LIMIT_UPLOAD=30

# Email
EMAIL_PROVIDER_API_KEY=${STAGING_EMAIL_API_KEY}
EMAIL_FROM_ADDRESS=noreply@staging.scholarmatch.org

# AI/Embedding
EMBEDDING_MODEL_NAME=text-embedding-3-small
QWEN_API_KEY=${STAGING_QWEN_API_KEY}
QWEN_TIMEOUT_SECONDS=30
QWEN_MAX_RETRIES=3

# Retention
ACCOUNT_DELETION_GRACE_DAYS=14

# Celery
CELERY_BROKER_URL=${STAGING_CELERY_BROKER_URL}
CELERY_RESULT_BACKEND=${STAGING_CELERY_RESULT_BACKEND}
