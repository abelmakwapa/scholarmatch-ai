# Safe local template. Copy to .env and replace blank values locally; never commit .env.
PROJECT_NAME=ScholarMatch AI API
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
LOG_LEVEL=INFO

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
JWKS_CACHE_TTL_SECONDS=300
JWKS_MAX_STALE_SECONDS=3600
JWKS_HTTP_TIMEOUT_SECONDS=5

QWEN_API_KEY=
QWEN_API_URL=https://dashscope-intl.aliyuncs.com/api/v1/services/aigc/text-generation/generation

REDIS_URL=
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
MATCHING_WEIGHTS={"academic_fit":0.30,"eligibility_fit":0.30,"interests_goals":0.15,"experience":0.10,"readiness_timing":0.15}
MATCHING_IMMEDIATE_LIMIT=100

PRIVATE_DOCUMENT_BUCKET=profile-documents
DOCUMENT_MAX_SIZE_BYTES=10485760
DOCUMENT_MAX_COUNT=25
DOCUMENT_QUOTA_BYTES=104857600
DOCUMENT_DOWNLOAD_TTL_SECONDS=300
