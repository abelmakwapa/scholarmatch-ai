# Every NEXT_PUBLIC_ value is embedded in browser code. Never put server secrets here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# Optional same-origin path (for example /api/observability); leave blank to disable reporting.
NEXT_PUBLIC_OBSERVABILITY_ENDPOINT=
